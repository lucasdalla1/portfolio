---
import Base from '../layouts/Base.astro';
import Social from '../components/Social.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base title="Página não encontrada" noindex>
  <div class="mx-auto flex min-h-dvh max-w-[44rem] flex-col px-6 pt-14 pb-10 sm:pt-24">
    <header class="flex items-center justify-between gap-4">
      <a href="/" class="text-2xl font-bold tracking-[-0.02em] text-ink">{site.shortName}</a>
      <div class="-mr-2"><Social /></div>
    </header>

    <main id="conteudo" class="reveal flex flex-1 flex-col justify-center py-24">
      <p class="font-mono text-xs tracking-[0.08em] text-muted uppercase">Erro 404</p>
      <h1 class="mt-3 text-3xl font-bold tracking-[-0.025em] text-ink sm:text-4xl">
        Essa página <mark class="hl hl-draw" style="--d: .3s">não existe</mark>.
      </h1>
      <p class="mt-4 max-w-md leading-relaxed text-muted">
        O endereço pode ter mudado ou ter sido digitado errado.
      </p>
      <a href="/" class="group mt-8 inline-flex w-fit items-center gap-1.5 text-sm font-medium text-ink">
        <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
        <span class="hl-hover">Voltar para o início</span>
      </a>
    </main>

    <Footer />
  </div>
</Base>
